<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkCheckButton" id="ui_radio_button">
    <property name="focusable">1</property>
    <property name="active">1</property>
    <property name="child">
      <object class="GtkBox">
        <property name="spacing">8</property>
        <child>
          <object class="GtkImage">
            <property name="file">../data/assets/video_card.svg</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel" id="ui_name_label">
                <property name="halign">start</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="ui_version_label">
                <property name="halign">start</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="ui_driver_label">
                <property name="halign">start</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="ui_repo_label">
                <property name="halign">start</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
