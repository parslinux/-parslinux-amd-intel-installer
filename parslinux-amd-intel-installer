#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ParsLinux AMD & Intel Installer
Launcher script supporting both system-installed and local-source environments.
"""

import os
import sys

# Locate directory: check local src/ first, then system path
current_dir = os.path.dirname(os.path.realpath(__file__))
local_src = os.path.join(current_dir, "src")
system_src = "/usr/share/parslinux/parslinux-amd-intel-installer/src"

if os.path.isdir(local_src) and os.path.isfile(os.path.join(local_src, "Main.py")):
    app_src = local_src
elif os.path.isdir(system_src) and os.path.isfile(os.path.join(system_src, "Main.py")):
    app_src = system_src
else:
    app_src = current_dir

if app_src not in sys.path:
    sys.path.insert(0, app_src)

if "-t" in sys.argv or "--tray" in sys.argv:
    tray_py = os.path.join(app_src, "tray.py")
    if os.path.isfile(tray_py):
        import subprocess
        sys.exit(subprocess.call([sys.executable, tray_py]))

try:
    import Main
    if hasattr(Main, "main"):
        sys.exit(Main.main())
    elif hasattr(Main, "app"):
        sys.exit(Main.app.run(sys.argv))
    else:
        app = Main.Application()
        sys.exit(app.run(sys.argv))
except Exception as e:
    print(f"Error launching ParsLinux AMD & Intel Installer: {e}", file=sys.stderr)
    sys.exit(1)
