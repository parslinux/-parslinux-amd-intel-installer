#!/bin/sh
set -e

case "$1" in
    purge)
        rm -f /var/cache/parslinux-disable-gpu
        rm -f /etc/parslinux-amd-intel-installer.conf
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
